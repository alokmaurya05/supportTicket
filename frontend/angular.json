{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "support-ticket-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": { "builder": "@angular/build:application", "options": { "outputPath": "dist/support-ticket-ui", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "assets": [], "styles": ["src/styles.css"] }, "configurations": { "production": { "outputHashing": "all" }, "development": { "optimization": false, "sourceMap": true, "extractLicenses": false } }, "defaultConfiguration": "production" },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "development": { "buildTarget": "support-ticket-ui:build:development" }, "production": { "buildTarget": "support-ticket-ui:build:production" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
